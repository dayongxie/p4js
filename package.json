{
  "name": "@dayongxie/p4js",
  "version": "0.1.2",
  "description": "Async Node-API binding to the Perforce C++ API with prebuilt Windows, Linux and macOS binaries",
  "license": "MIT",
  "author": "dayongxie",
  "keywords": [
    "perforce",
    "p4",
    "node-addon",
    "napi",
    "native-addon"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.js.map",
    "prebuilds",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "gypfile": false,
  "scripts": {
    "setup": "node scripts/setup-sdk.mjs",
    "build": "node scripts/build.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "build:native": "node-gyp rebuild",
    "build:js": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "pretest": "node scripts/build.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "clean": "node scripts/clean.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "prepublishOnly": "npm run build:js && node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.4.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayongxie/p4js.git"
  },
  "homepage": "https://github.com/dayongxie/p4js#readme",
  "bugs": {
    "url": "https://github.com/dayongxie/p4js/issues"
  }
}
